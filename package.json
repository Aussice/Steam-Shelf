{
  "name": "steam-3d-shelf",
  "productName": "Steam Shelf",
  "version": "0.8.0",
  "private": true,
  "description": "A personal 3D shelf for your Steam games",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "app": "electron .",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "pack": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "koffi": "^3.3.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@vitejs/plugin-react": "latest",
    "@xmldom/xmldom": "^0.8.15",
    "electron": "43.1.0",
    "electron-builder": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "studio.steamshelf.desktop",
    "electronDist": "node_modules/electron/dist",
    "productName": "Steam Shelf",
    "artifactName": "Steam Shelf.${ext}",
    "directories": {
      "output": "release/0.8.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "asarUnpack": [
      "electron/steam-client.cjs",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ]
  },
  "author": "Steam Shelf"
}
